  "info": {
    "title": "CLPS Lunar Mission Browser API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "get_meta_api_v1_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meta"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Meta"
      }
    },
    "/api/v1/scenario/series": {
      "get": {
        "operationId": "get_series_api_v1_scenario_series_get",
        "parameters": [
          {
            "in": "query",
            "name": "site",
            "required": true,
            "schema": {
              "title": "Site",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "t0",
            "required": true,
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:\\d0Z$",
              "title": "T0",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "month",
            "required": true,
            "schema": {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "title": "Month",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 30,
              "maximum": 365,
              "minimum": 1,
              "title": "Days",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "panel",
            "required": false,
            "schema": {
              "default": 2,
              "maximum": 10,
              "minimum": 1,
              "title": "Panel",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "antenna",
            "required": false,
            "schema": {
              "default": 3,
              "maximum": 10,
              "minimum": 1,
              "title": "Antenna",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "w",
            "required": false,
            "schema": {
              "default": "1,1,1,0",
              "pattern": "^(0(\\.\\d)?|1(\\.0)?)(,(0(\\.\\d)?|1(\\.0)?)){3}$",
              "title": "W",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "station",
            "required": false,
            "schema": {
              "default": "29.7604,-95.3698,0,0",
              "title": "Station",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "v",
            "required": false,
            "schema": {
              "default": "",
              "title": "V",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeriesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Series"
      }
    },
    "/api/v1/scenario/summary": {
      "get": {
        "operationId": "get_summary_api_v1_scenario_summary_get",
        "parameters": [
          {
            "in": "query",
            "name": "site",
            "required": true,
            "schema": {
              "title": "Site",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "t0",
            "required": true,
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}:\\d0Z$",
              "title": "T0",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 30,
              "maximum": 365,
              "minimum": 1,
              "title": "Days",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "panel",
            "required": false,
            "schema": {
              "default": 2,
              "maximum": 10,
              "minimum": 1,
              "title": "Panel",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "antenna",
            "required": false,
            "schema": {
              "default": 3,
              "maximum": 10,
              "minimum": 1,
              "title": "Antenna",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "w",
            "required": false,
            "schema": {
              "default": "1,1,1,0",
              "pattern": "^(0(\\.\\d)?|1(\\.0)?)(,(0(\\.\\d)?|1(\\.0)?)){3}$",
              "title": "W",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "station",
            "required": false,
            "schema": {
              "default": "29.7604,-95.3698,0,0",
              "title": "Station",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "v",
            "required": false,
            "schema": {
              "default": "",
              "title": "V",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Summary"
      }
    },
    "/api/v1/sites": {
      "get": {
        "operationId": "list_sites_api_v1_sites_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SitesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Sites"
      }
    },
    "/api/v1/sites/custom": {
      "post": {
        "description": "Contract only (slice S7): the engine builds the point's terrain and returns it as\na site whose id encodes the point, so the call is idempotent (spec \u00a78.2).\n\nOpen decision for when the engine lands: CORS allows GET only, so a web app on\nanother origin cannot call this yet (tests/test_api_basic.py guards that).",
        "operationId": "create_custom_site_api_v1_sites_custom_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomPointRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Site"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Custom Site"
      }
    },
    "/api/v1/sites/{site_id}": {
      "get": {
        "operationId": "get_site_api_v1_sites__site_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "title": "Site Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Site"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Site"
      }
    },
    "/api/v1/sites/{site_id}/horizon": {
      "get": {
        "operationId": "get_horizon_api_v1_sites__site_id__horizon_get",
        "parameters": [
          {
            "in": "path",
            "name": "site_id",
            "required": true,
            "schema": {
              "title": "Site Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "mast",
            "required": false,
            "schema": {
              "default": 2,
              "maximum": 10,
              "minimum": 1,
              "title": "Mast",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "part",
            "required": false,
            "schema": {
              "default": "full",
              "enum": [
                "full",
                "far"
              ],
              "title": "Part",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "v",
            "required": false,
            "schema": {
              "default": "",
              "title": "V",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HorizonResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Horizon"
      }
    }
  }
