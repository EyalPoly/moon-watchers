    {
      "code": "UNCERTAINTY_UNAVAILABLE",
      "severity": "info",
      "affects": "skyline",
      "text": "The height-error map doesn't cover the whole skyline, so the range is unavailable.",
      "standing": false
    },
    {
      "code": "SPARSE_MEASUREMENTS",
      "severity": "caution",
      "affects": "all",
      "text": "Fewer than one laser measurement per pixel at the site: the terrain here is interpolated.",
      "standing": false
    },
    {
      "code": "EFFECTIVE_RESOLUTION",
      "severity": "caution",
      "affects": "slope",
      "text": "The data's effective resolution here is coarser than the 20 m slope map.",
      "standing": false
    },
    {
      "code": "EARTH_ORIENTATION_PREDICTED",
      "severity": "info",
      "affects": "contact",
      "text": "The mission runs past 2026-08-06, so the Earth's orientation, and the station's position, are predicted rather than observed.",
      "standing": false
    },
    {
      "code": "NULL_GRADE",
      "severity": "caution",
      "affects": "score",
      "text": "{label} could not be computed, so its grade counts as 0.",
      "standing": false
    },
    {
      "code": "PSR_UNKNOWN",
      "severity": "info",
      "affects": "score",
      "text": "The PSR map has no value at this site, so the PSR check wasn't applied.",
      "standing": false
    },
    {
      "code": "EXCLUDED_PSR",
      "severity": "blocking",
      "affects": "score",
      "text": "Excluded: the site is inside a permanently shadowed region, so every grade is 0.",
      "standing": false
    },
    {
      "code": "EXCLUDED_SLOPE",
      "severity": "blocking",
      "affects": "score",
      "text": "Excluded: the slope {slope}° is above the {max}° limit, so the score is 0.",
      "standing": false
    },
    {
      "code": "DEM_RESOLUTION",
      "severity": "info",
      "affects": "all",
      "text": "Rocks and relief smaller than a terrain cell are not modeled.",
      "standing": true
    },
    {
      "code": "GEOMETRIC_CONTACT",
      "severity": "info",
      "affects": "contact",
      "text": "Contact uses instantaneous positions (no light-time delay).",
      "standing": true
    },
    {
      "code": "DISK_QUADRATURE",
      "severity": "info",
      "affects": "sun",
      "text": "The Sun's and Earth's disks use 128-strip sampling and a small-angle approximation.",
      "standing": true
    },
    {
      "code": "CUSTOM_COARSE_TERRAIN",
      "severity": "caution",
      "affects": "all",
      "text": "This point uses 80 m terrain and the 80 m slope map; catalog sites use 20 m. Near-horizon angles can differ by up to about 0.7 degrees, and the slope is usually smoother.",
      "standing": false
    }
  ]
